# Local dev env for hivesync — copy to .env (gitignored) and fill in.
# `npm run dev` loads this via node --env-file-if-exists; `npm start` (Render) ignores it.

# REQUIRED — the Neon Postgres connection string. Copy from Render → app → Environment.
DATABASE_URL=

# Message classification (vault: airlock-config/secrets/.env.constellation → OPENAI_API_KEY)
OPENAI_API_KEY=

# Gates the dashboard's Community Ops tabs (any strong random string)
ADMIN_KEY=

# Discord gateway bot (developer portal → Bot; privileged intents enabled)
DISCORD_BOT_TOKEN=
# https://<host>/api/discord/webhook/<api_key> from POST /api/communities
DISCORD_WEBHOOK_URL=
